{
  // The root holds only shared fmt settings, no dependencies: a deno run from here must not
  // write a stray deno.lock. Each package keeps its own (devc/, devc-core/, devc-bridge/host/).
  "lock": false,
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    // Vendored, unmodified xterm.js — see scripts/vendor-xterm.sh.
    "exclude": ["devc/web/static/vendor/"]
  }
}
