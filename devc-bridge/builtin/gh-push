#!/usr/bin/env bash
# gh-push — publish one of this container's pinned branches to its pinned remote.
#   devc-bridge gh-push [--repo <path>]
#
# `--repo <path>` selects the pinned repo by its path in the container, and is required once the
# policy pins more than one (`devc up --bridge-repo`). It is the only argument: the policy names the
# repo, remote and branch.
#
# Built in: runs only for a container whose policy grants `gh-push`
# (`devc up --bridge-allow gh-push`). The bridge checks that some line grants it before running this;
# the check below — of the selected line's grants — is the binding one.
#
# Who is asking comes from the bridge, not the caller: the server sets DEVC_BRIDGE_KEY to the
# workspace key its token identifies (empty for the shared legacy token) and
# DEVC_BRIDGE_POLICY_DIR to the host-only policy dir. `policy/<key>.conf`, written by devc, is the
# whole grant — one `<repo>\t<remote>\t<branch>\t<grants>\t<target>` line per pinned repo, the
# workspace repo first, each line with its own grants: the line `--repo` selects must grant
# `gh-push`. No file, no push.
#
# **The host never runs git inside the container's repo.** A hook or `core.fsmonitor` planted there
# executes on any `git -C <repo> …`, and `--no-verify` does not contain repo-local `core.sshCommand`
# or an `ext::` `insteadOf` rewrite. So the only thing this script does to the repo is *fetch from
# it* into a host-owned bare mirror — git distrusts the config of a repo it fetches from — and every
# later step runs in the mirror. The pushed object is the SHA that was inspected, never the
# branch ref, which the agent can move at any moment.
#
# GitHub only: the remote must have one of the shapes gh-pr-*'s parse_remote accepts, and is always
# reached over HTTPS with gh's credential as git's only helper, so `gh auth login` on the host is
# the whole setup; the policy and the mirror keep the remote verbatim. devc refuses any other remote
# at grant time; the check below is the second layer, since a policy file can be edited by hand.
#
# Two more modes, for the user rather than an agent, selected by DEVC_PUSH_MODE alone — which only
# devc's CLI sets (`devc git push-plan` / `devc git push`) and the bridge strips from every script's
# environment, so `devc-bridge gh-push` always runs the agent's mode:
#   DEVC_PUSH_MODE=plan gh-push [--repo <path>]             # JSON on stdout: what a push would do
#   DEVC_PUSH_MODE=user gh-push [--repo <path>] --sha <sha>  # push <sha>, the tip the plan showed
# The user's push waives two refusals: the default branch, and a change under .github/workflows or
# .github/actions (the plan lists both, so the confirming UI can warn). Everything else holds: the
# mirror, the inspected SHA, and the refusals of an LFS pointer (exit 3) and of a push that is not a
# fast-forward (exit 4 — nothing here ever forces). `--sha` must be the branch's tip as freshly
# fetched from the repo, or the push is refused (exit 2, `the branch moved`). The plan's `subject`,
# `author` and `guarded` are the repo's text, written by whoever wrote the commits.
#
# Exit codes: 0 pushed (or already up to date), 2 wrong arguments, no/malformed policy, no single
# pinned repo selected, a pin that no longer resolves, a remote that is not GitHub, or a remote
# mismatch, 3 content-policy refusal or a pinned branch that is the remote's default branch,
# 4 transport failure or timeout, another gh-push holding this remote's mirror past the timeout, or
# (user mode) a push that is not a fast-forward.

set -uo pipefail
export LC_ALL=C
# The daemon's cwd is wherever `devc-bridge start` ran — possibly inside a project. Every path below
# is absolute, and no git here may discover a repo from the cwd.
cd / || exit 4

die() {
  local code=$1
  shift
  echo "gh-push: $*" >&2
  exit "$code"
}

# The mode is read once and dropped, so nothing this script runs inherits it.
mode=${DEVC_PUSH_MODE-}
unset DEVC_PUSH_MODE
case $mode in
  '' | plan | user) ;;
  *) die 2 "unknown DEVC_PUSH_MODE $mode — plan or user" ;;
esac

USAGE="usage: gh-push [--repo <path>]"
[ "$mode" != user ] || USAGE="usage: DEVC_PUSH_MODE=user gh-push [--repo <path>] --sha <sha>"
# Recognized only as the first argument, and only in the space form.
want_repo=''
if [ "${1-}" = --repo ]; then
  [ -n "${2-}" ] || die 2 "$USAGE"
  want_repo=$2
  shift 2
fi
# User mode only, and required there: the full SHA the user confirmed.
want_sha=''
if [ "$mode" = user ]; then
  [ "${1-}" = --sha ] && [ -n "${2-}" ] || die 2 "$USAGE"
  want_sha=$2
  shift 2
  [[ $want_sha =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] ||
    die 2 "--sha wants a full lowercase commit SHA, not $want_sha"
fi
[ $# -eq 0 ] || die 2 "$USAGE"

# ── the caller and its policy ─────────────────────────────────────────────────────────────

key=${DEVC_BRIDGE_KEY-}
[ -n "$key" ] || die 2 "this caller has no workspace key (the shared token can never push)"
case $key in
  . | .. | *[!A-Za-z0-9._-]*) die 2 "invalid workspace key" ;;
esac

policy_dir=${DEVC_BRIDGE_POLICY_DIR:-$HOME/.config/devc-bridge/policy}
policy=$policy_dir/$key.conf
[ -f "$policy" ] ||
  die 2 "no push policy for this container — on the host: devc up --bridge-allow gh-push"

# ── shared with gh-doctor and the gh-pr-* prelude: keep the copies identical ─────────────

# parse_policy FILE — read a policy into the arrays pol_repo/pol_remote/pol_branch/pol_grants/
# pol_target (one entry per line, file order), or set pol_why and fail. The rules are devc-core's
# policyProblem: 1–16 lines, each `\n`-terminated, each exactly five non-empty, control-free,
# tab-separated fields `<repo> <remote> <branch> <grants> <target>`; the target absolute and
# normalized; each line's own grants; repo and target each distinct. A four-field v1 file
# is malformed. The whole file is read with the `x` sentinel (so trailing newlines survive) and split
# by hand: `read` cannot split it, because tab is IFS whitespace and empty fields would collapse.
parse_policy() {
  local text line rest tabs field n=0 i r_repo r_remote r_branch r_grants r_target
  pol_repo=() pol_remote=() pol_branch=() pol_grants=() pol_target=() grants='' pol_why=''
  text=$(cat -- "$1" && printf x) || {
    pol_why="unreadable"
    return 1
  }
  text=${text%x}
  case $text in *$'\n') ;; *)
    pol_why="the file does not end with a newline"
    return 1
    ;;
  esac
  text=${text%$'\n'}
  while :; do
    n=$((n + 1))
    [ "$n" -le 16 ] || {
      pol_why="more than 16 lines"
      return 1
    }
    line=${text%%$'\n'*}
    [ -n "$line" ] || {
      pol_why="line $n is empty"
      return 1
    }
    tabs=${line//[!$'\t']/}
    [ ${#tabs} -eq 4 ] || {
      pol_why="line $n: want 5 tab-separated fields, found $((${#tabs} + 1))"
      return 1
    }
    r_repo=${line%%$'\t'*}
    rest=${line#*$'\t'}
    r_remote=${rest%%$'\t'*}
    rest=${rest#*$'\t'}
    r_branch=${rest%%$'\t'*}
    rest=${rest#*$'\t'}
    r_grants=${rest%%$'\t'*}
    r_target=${rest#*$'\t'}
    for field in "$r_repo" "$r_remote" "$r_branch" "$r_grants" "$r_target"; do
      [ -n "$field" ] || {
        pol_why="line $n: empty field"
        return 1
      }
      case $field in *[[:cntrl:]]*)
        pol_why="line $n: control character in a field"
        return 1
        ;;
      esac
    done
    case $r_repo in /*) ;; *)
      pol_why="line $n: repo is not an absolute path"
      return 1
      ;;
    esac
    case $r_remote in -*)
      pol_why="line $n: remote looks like an option"
      return 1
      ;;
    esac
    git check-ref-format "refs/heads/$r_branch" || {
      pol_why="line $n: branch is not a valid ref name"
      return 1
    }
    [[ $r_grants =~ ^[a-z][a-z-]*(,[a-z][a-z-]*)*$ ]] || {
      pol_why="line $n: bad grants field"
      return 1
    }
    case $r_target in
      / | */ | *//* | */./* | */../* | */. | */.. | [!/]*)
        pol_why="line $n: target is not a normalized absolute path"
        return 1
        ;;
    esac
    i=0
    while [ "$i" -lt "${#pol_repo[@]}" ]; do
      [ "${pol_repo[$i]}" != "$r_repo" ] || {
        pol_why="line $n: repo repeats line $((i + 1))'s"
        return 1
      }
      [ "${pol_target[$i]}" != "$r_target" ] || {
        pol_why="line $n: target repeats line $((i + 1))'s"
        return 1
      }
      i=$((i + 1))
    done
    pol_repo+=("$r_repo")
    pol_remote+=("$r_remote")
    pol_branch+=("$r_branch")
    pol_grants+=("$r_grants")
    pol_target+=("$r_target")
    case $text in
      *$'\n'*) text=${text#*$'\n'} ;;
      *) return 0 ;;
    esac
  done
}

# ── shared with the gh-pr-* prelude: keep the two copies identical ───────────────────────

# select_repo WANT — pick the policy line whose target is WANT (trailing `/`s dropped), or, with
# WANT empty, the only line; sets repo/remote/branch/grants/target from it — the grants are that
# line's own — or exits 2 listing the pinned targets. Plain string comparison: devc writes every
# target normalized.
select_repo() {
  local want=$1 t list='' i=0 pick=-1
  while [ "$i" -lt "${#pol_target[@]}" ]; do
    list=${list:+$list, }${pol_target[$i]}
    i=$((i + 1))
  done
  if [ -z "$want" ]; then
    [ "${#pol_target[@]}" -eq 1 ] ||
      die 2 "this container has ${#pol_target[@]} pinned repos — pass --repo <path>, one of: $list"
    pick=0
  else
    t=$want
    while [ "${t%/}" != "$t" ]; do t=${t%/}; done
    i=0
    while [ "$i" -lt "${#pol_target[@]}" ]; do
      [ "${pol_target[$i]}" != "$t" ] || pick=$i
      i=$((i + 1))
    done
    [ "$pick" -ge 0 ] || die 2 "no pinned repo at $want — pinned: $list"
  fi
  repo=${pol_repo[$pick]}
  remote=${pol_remote[$pick]}
  branch=${pol_branch[$pick]}
  grants=${pol_grants[$pick]}
  target=${pol_target[$pick]}
}

parse_policy "$policy" || die 2 "malformed policy $policy: $pol_why"
select_repo "$want_repo"
# The selected line's own grants; with several lines the refusal names its target.
case ,$grants, in
  *,gh-push,*) ;;
  *)
    if [ "${#pol_target[@]}" -gt 1 ]; then
      die 2 "this container was not granted gh-push for $target"
    fi
    die 2 "this container was not granted gh-push"
    ;;
esac

# ── shared with gh-doctor: keep the two copies identical ─────────────────────────────────

# parse_remote URL — sets head_owner/head_name. Three shapes, github.com or a `github.com-*` ssh
# host alias; anything else fails. (Verbatim from the gh-pr-* prelude.)
parse_remote() {
  local rest host path
  case $1 in
    git@*:*) rest=${1#git@} host=${rest%%:*} path=${rest#*:} ;;
    ssh://git@*/*) rest=${1#ssh://git@} host=${rest%%/*} path=${rest#*/} ;;
    https://*/*) rest=${1#https://} host=${rest%%/*} path=${rest#*/} ;;
    *) return 1 ;;
  esac
  case $host in github.com | github.com-*) ;; *) return 1 ;; esac
  case $host in *[!A-Za-z0-9.-]*) return 1 ;; esac
  path=${path%.git}
  case $path in */*) ;; *) return 1 ;; esac
  head_owner=${path%%/*}
  head_name=${path#*/}
  valid_name "$head_owner" && valid_name "$head_name"
}

valid_name() { # an owner or repo name: also keeps `..` out of an API path
  case $1 in '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;; esac
}

unset GH_REPO GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_DEBUG GH_PAGER GH_CONFIG_DIR_OVERRIDE
export GH_HOST=github.com GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 NO_COLOR=1

# transport_setup REMOTE — sets url (the HTTPS URL every network git call is given), NET_ENV
# (env assignments for them) and NET_FLAGS: no user or system git config (no `insteadOf` can turn
# it back into SSH, no other helper can answer), and gh as the only credential helper. There is no
# other transport. Fails, printing why, for a remote that is not GitHub or a gh path that cannot be
# quoted.
transport_setup() {
  NET_ENV=() NET_FLAGS=() url=''
  parse_remote "$1" || {
    echo "unsupported remote $1 — only github.com"
    return 1
  }
  url=https://github.com/$head_owner/$head_name.git
  gh_bin=$(command -v gh) || gh_bin=''
  case $gh_bin in *\'*)
    echo "unusable gh path $gh_bin"
    return 1
    ;;
  esac
  NET_ENV=(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1)
  # git runs a `!` helper through the shell, hence the quotes; the empty value resets the list.
  NET_FLAGS=(-c credential.helper= -c "credential.helper=!'$gh_bin' auth git-credential")
}

# gh_ready — 0 gh can supply the credential, 2 gh is not installed, 3 gh is
# not logged in to github.com. Needs run_t, so call it after that is defined.
GH_MISSING="gh is not installed on the host (not on the bridge's PATH)"
gh_ready() {
  [ -n "$gh_bin" ] || return 2
  run_t "$gh_bin" auth status --hostname github.com >/dev/null 2>&1 || return 3
}
timeout_s=${DEVC_BRIDGE_GIT_TIMEOUT:-300}
case $timeout_s in '' | *[!0-9]*) timeout_s=300 ;; esac

# Before anything is touched: every gh- capability acts through the host's gh login.
parse_remote "$remote" || die 2 "unsupported remote $remote — only github.com"

# One mirror per remote, under the key. Two pinned repos on the same GitHub repo — worktrees of
# one primary, on different branches (devc refuses the same branch twice, and two URL spellings of
# one repo) — share it, so it is locked below. `valid_name` keeps owner and name path-safe.
mirror=$HOME/.local/state/devc-bridge/git/$key/$head_owner/$head_name.git
lock=$mirror.lock
locked=''

# ── the environment every git below runs in ───────────────────────────────────────────────

# Nothing inherited from the daemon's shell may point git somewhere else, and nothing may prompt: the
# client blocks until this script returns and has no timeout of its own.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_CONFIG GIT_CONFIG_PARAMETERS \
  GIT_CONFIG_COUNT GIT_ASKPASS SSH_ASKPASS GIT_SSH GIT_PROXY_COMMAND GIT_EXTERNAL_DIFF
export GIT_TERMINAL_PROMPT=0
# An allowlist rather than a denylist: `ext::` (arbitrary command), ssh and everything else is
# refused. `file` stays for the one fetch from the container's repo, which is by local path.
export GIT_ALLOW_PROTOCOL=file:https

# For every invocation: the mirror's own hooks (a user `init.templateDir` could supply some) never
# run, nothing asks, and nothing follows tags or submodules into a push.
GIT_FLAGS=(-c core.hooksPath=/dev/null -c core.askPass= -c core.pager=cat
  -c protocol.ext.allow=never -c push.followTags=false -c push.recurseSubmodules=no
  -c fetch.recurseSubmodules=no -c submodule.recurse=false -c gc.auto=0)
MIRROR_GIT=(git "${GIT_FLAGS[@]}" --git-dir="$mirror")
# For the one fetch *from the agent's repo*: every command-running key blanked as well. Git already
# ignores these from a repo it fetches from; this is belt-and-braces, not the control.
SOURCE_GIT=(git "${GIT_FLAGS[@]}" -c core.fsmonitor=false -c uploadpack.packObjectsHook=
  -c core.alternateRefsCommand= -c credential.helper= --git-dir="$mirror")

tmp=$(mktemp -d "${TMPDIR:-/tmp}/devc-bridge-gh-push.XXXXXX") || die 4 "cannot create a temp dir"
# The EXIT trap acts only in the main shell. run_t's watcher subshell, killed right after it forks,
# can run an inherited copy of this trap — and would delete $tmp, or release the mirror lock another
# run is now relying on, mid-push. bash 3.2 (macOS) has no BASHPID, so compare the trapping
# shell's pid (a child's $PPID) with the one saved here.
main_pid=$$
on_exit() {
  [ "$(exec sh -c 'echo $PPID')" = "$main_pid" ] || return 0
  [ -z "$locked" ] || rmdir -- "$lock" 2>/dev/null
  rm -rf "$tmp"
}
trap on_exit EXIT

# run_t CMD… — run CMD with stdin closed, killing its whole process group after $timeout_s.
# macOS ships no timeout(1). The group matters: git leaves its transport helper (git-remote-https,
# and gh under it) holding the bridge's stdout pipe, and the bridge waits for EOF on it, so killing
# git alone would still hang the client.
run_t() {
  rm -f "$tmp/timedout"
  set -m
  "$@" </dev/null &
  local pid=$!
  (
    sleep "$timeout_s"
    : >"$tmp/timedout"
    kill -s TERM -- "-$pid"
    sleep 5
    kill -s KILL -- "-$pid"
  ) </dev/null >/dev/null 2>&1 &
  local watcher=$!
  set +m
  local rc=0
  wait "$pid" 2>/dev/null || rc=$?
  kill -s TERM -- "-$watcher" 2>/dev/null
  wait "$watcher" 2>/dev/null
  return "$rc"
}

# net STEP CMD… — a network step: any failure is exit 4, a timeout says so.
net() {
  local step=$1
  shift
  run_t "$@" && return 0
  [ -e "$tmp/timedout" ] && die 4 "$step: timed out after ${timeout_s}s"
  die 4 "$step failed"
}

# ── the repo is only ever read as files ───────────────────────────────────────────────────

# ── shared with gh-doctor: keep the two copies identical ─────────────────────────────────

phys() { (cd -P -- "$1" 2>/dev/null && pwd -P); }

# read_pointer FILE — the path after `gitdir: ` on FILE's first line, resolved against FILE's dir.
read_pointer() {
  local file=$1 first='' target
  IFS= read -r first <"$file" || [ -n "$first" ] || return 1
  target=${first#gitdir: }
  [ "$target" != "$first" ] && [ -n "$target" ] || return 1
  case $target in /*) ;; *) target=$(dirname -- "$file")/$target ;; esac
  printf '%s\n' "$target"
}

# pointer_problem WORKTREE — print why WORKTREE/.git is not an honest linked-worktree pointer and
# fail, or print its git dir and succeed. Honest means: `gitdir: <primary>/.git/worktrees/<name>`,
# whose `gitdir` points back at WORKTREE/.git and whose `commondir` is `<primary>/.git`.
pointer_problem() {
  local wt=$1 gitdir back='' common here
  gitdir=$(read_pointer "$wt/.git") || {
    echo "$wt/.git is not a gitdir: pointer"
    return 1
  }
  gitdir=$(phys "$gitdir") || {
    echo "$wt/.git points at a git dir that does not exist"
    return 1
  }
  case $gitdir in
    */.git/worktrees/*) ;;
    *)
      echo "$wt/.git points at $gitdir, not a <repo>/.git/worktrees/<name> dir"
      return 1
      ;;
  esac
  IFS= read -r back <"$gitdir/gitdir" 2>/dev/null || [ -n "$back" ] || {
    echo "$gitdir has no gitdir back-pointer"
    return 1
  }
  case $back in /*) ;; *) back=$gitdir/$back ;; esac
  here=$(phys "$wt")
  [ "$(phys "$(dirname -- "$back")")/$(basename -- "$back")" = "$here/.git" ] || {
    echo "$gitdir/gitdir does not point back at $wt/.git"
    return 1
  }
  common=$(cat -- "$gitdir/commondir" 2>/dev/null) || {
    echo "$gitdir has no commondir"
    return 1
  }
  case $common in /*) ;; *) common=$gitdir/$common ;; esac
  [ "$(phys "$common")" = "$(phys "$gitdir/../..")" ] || {
    echo "$gitdir/commondir points outside its primary git dir"
    return 1
  }
  printf '%s\n' "$gitdir"
}

# The fetch below resolves the repo's `.git` the way git does, so whatever it points at is what gets
# published. Refuse any pointer that could redirect it at a repo the container cannot see. For a
# linked worktree both halves of the pointer live in git dirs the container can already reach, so a
# pointer that passes cannot publish anything it could not have copied into its own branch anyway.
if [ -d "$repo/.git" ]; then
  # A primary repo. `.git/commondir` would make git take refs and objects from another git dir.
  [ ! -e "$repo/.git/commondir" ] ||
    die 2 "$repo/.git/commondir exists — a primary repo has none, so something redirected it"
elif [ -f "$repo/.git" ]; then
  reason=$(pointer_problem "$repo") || die 2 "refused: $reason"
else
  die 2 "$repo is not a git repo (no .git)"
fi

# ── the mirror ────────────────────────────────────────────────────────────────────────────

# One push per mirror at a time: two worktrees of one repo share it, and two sessions can push at
# once. `mkdir` is the lock — atomic on every filesystem, on macOS and Linux alike, with no
# flock(1) on macOS. A lock older than any run could legitimately hold it (four timed git steps,
# plus slack) is left by a run that was killed, and is taken over.
mkdir -p -- "$(dirname -- "$mirror")" || die 4 "cannot create $(dirname -- "$mirror")"
stale_min=$(((4 * timeout_s + 60 + 59) / 60))
waited=0
until mkdir -- "$lock" 2>/dev/null; do
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +"$stale_min" 2>/dev/null)" ]; then
    rmdir -- "$lock" 2>/dev/null
    continue
  fi
  [ "$waited" -lt "$timeout_s" ] ||
    die 4 "another gh-push is using the mirror for $head_owner/$head_name — try again (if none is running, remove $lock)"
  sleep 1
  waited=$((waited + 1))
done
locked=1

# Created from the policy, never cloned from the agent's repo, whose config would be inherited.
# Built under a temp name and renamed in, so an interrupted setup never leaves a half-made mirror.
if [ ! -d "$mirror" ]; then
  staging=$mirror.tmp.$$
  rm -rf -- "$staging"
  if ! { git init -q --bare --template= -- "$staging" >/dev/null &&
    git --git-dir="$staging" config remote.origin.url "$remote" &&
    mv -- "$staging" "$mirror"; }; then
    rm -rf -- "$staging"
    die 4 "cannot create the mirror at $mirror"
  fi
fi

# The mirror's origin is host-authored at creation and is the authority: if the policy disagrees,
# something rewrote one of them — refuse rather than reconcile. Read from the file, not via
# `remote get-url`, which applies `insteadOf` rewriting.
origin=$(git config --file "$mirror/config" --get remote.origin.url) ||
  die 2 "mirror $mirror has no origin — delete it to re-create"
[ "$origin" = "$remote" ] ||
  die 2 "policy remote $remote does not match mirror origin $origin"

# ── what the remote has ───────────────────────────────────────────────────────────────────

# The default branch is not assumed to be `main`: read it from the remote on every push.
transport_setup "$remote" >"$tmp/why" || die 4 "$(cat "$tmp/why")"
# `${a[@]+…}`: bash 3.2 (macOS) calls an empty array unbound under `set -u`.
NET_GIT=(env ${NET_ENV[@]+"${NET_ENV[@]}"} "${MIRROR_GIT[@]}" ${NET_FLAGS[@]+"${NET_FLAGS[@]}"})
gh_ready
case $? in
  0) ;;
  2) die 4 "$GH_MISSING" ;;
  *) die 4 "gh is not authenticated in the bridge's environment — run gh auth login on the host, then devc-bridge restart" ;;
esac

net "reading $remote" "${NET_GIT[@]}" ls-remote --symref -- "$url" HEAD "refs/heads/$branch" \
  >"$tmp/ls-remote"
base=$(awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2; exit }' \
  "$tmp/ls-remote")
[ -n "$base" ] ||
  die 3 "$remote has no default branch, so there is nothing to check the branch against"
# The default branch is never publishable, whatever the pin says. The pin is the user's grant, but
# `HEAD` is agent-writable, and nothing else stands between a pin that ended up on the default
# branch and a push to it. Exact comparison: ref names are case-sensitive, and `base` is the
# remote's own answer, so a pin named `main` on a remote whose default is `master` still pushes.
# The user's modes waive it (D1 of devc-git-user-push): the user pins the branch at the moment of
# asking, and sees it named as the default branch before confirming.
[ -n "$mode" ] || [ "$branch" != "$base" ] ||
  die 3 "refused: $branch is the default branch of $remote — gh-push publishes only a non-default branch; on the host, check out another branch and run devc up --bridge-allow $grants"
# Not the symref line, whose second field also names the default branch.
remote_sha=$(awk -v ref="refs/heads/$branch" '$1 != "ref:" && $2 == ref { print $1; exit }' \
  "$tmp/ls-remote")

# Fresh every time — a stale base would let the content policy compare against the wrong tree.
# The pinned branch's remote tip comes along when there is one: what is already on the remote is
# trusted as much as the default branch. When there is none, a tip cached by an earlier run is
# dropped — a branch deleted on the remote no longer vouches for anything.
# (`branch` is `base` only in the user's modes: then the base's ref is the tip.)
refspecs=("+refs/heads/$base:refs/remotes/origin/$base")
tip=''
if [ "$branch" = "$base" ]; then
  tip=refs/remotes/origin/$base
elif [ -n "$remote_sha" ]; then
  tip=refs/remotes/origin/$branch
  refspecs+=("+refs/heads/$branch:$tip")
else
  "${MIRROR_GIT[@]}" update-ref -d "refs/remotes/origin/$branch" 2>/dev/null
fi
net "fetching $base from $remote" "${NET_GIT[@]}" fetch -q --no-tags -- "$url" "${refspecs[@]}"

# ── what the agent wants published ────────────────────────────────────────────────────────

# `refs/staging/*`, never `refs/heads/*`: nothing in the mirror's branch namespace for a wildcard
# refspec to sweep. `+` because the agent may rebase; the push itself still never forces.
run_t "${SOURCE_GIT[@]}" fetch -q --no-tags --no-write-fetch-head -- "$repo" \
  "+refs/heads/$branch:refs/staging/$branch" ||
  die 2 "cannot read branch $branch from $repo"
sha=$("${MIRROR_GIT[@]}" rev-parse --verify -q "refs/staging/$branch^{commit}") ||
  die 2 "refs/staging/$branch is not a commit"
short=${sha:0:12}
# What the user confirmed is what goes out, or nothing does.
[ -z "$want_sha" ] || [ "$sha" = "$want_sha" ] ||
  die 2 "the branch moved: $branch is now $short, not ${want_sha:0:12} — check the push again"

# ── content policy, against the inspected SHA ─────────────────────────────────────────────

# Workflows, and the local actions they can `uses: ./.github/actions/…`, run with the repo's secrets
# from whatever commit was pushed. Each path there must match a version already trusted — the
# default branch's or the remote branch tip's — so the branch may carry a workflow change the user
# pushed, and pick up the default branch's, but nothing new comes in through this push.
# Plumbing, not `git diff`: no external diff, no textconv, no rename pairing that could hide one side.
# The user's modes collect what the agent's would refuse into `guarded` instead.
guarded=()
"${MIRROR_GIT[@]}" diff-tree -r --no-renames --name-only -z "refs/remotes/origin/$base" "$sha" \
  -- .github/workflows .github/actions >"$tmp/guarded" ||
  die 3 "refused: could not diff $branch against $base"
while IFS= read -r -d '' path; do
  if [ -z "$tip" ]; then
    [ -n "$mode" ] || die 3 "refused: $branch changes $path relative to $base"
    guarded+=("$path")
    continue
  fi
  "${MIRROR_GIT[@]}" --literal-pathspecs diff-tree --quiet -r --no-renames "$tip" "$sha" -- "$path"
  case $? in
    0) ;;
    1)
      [ -n "$mode" ] ||
        die 3 "refused: $branch changes $path relative to both $base and the remote $branch"
      guarded+=("$path")
      ;;
    *) die 3 "refused: could not diff $branch against the remote $branch" ;;
  esac
done <"$tmp/guarded"

# LFS: the mirror only ever receives pointer blobs; the objects stay in the working repo. Pushing a
# new pointer would publish a commit whose content was never uploaded.
"${MIRROR_GIT[@]}" diff-tree -p -r --no-renames --no-ext-diff --no-textconv \
  "refs/remotes/origin/$base" "$sha" >"$tmp/diff" ||
  die 3 "refused: could not diff $branch against $base"
lfs=false
if grep -q '^+version https://git-lfs' "$tmp/diff"; then
  [ "$mode" = plan ] ||
    die 3 "refused: $branch adds a Git LFS pointer, and LFS content cannot be published this way"
  lfs=true
fi

# Whether the remote branch's tip is an ancestor of the SHA. The agent's push leaves this to the
# remote, which rejects it; the user's refuses it here, before the push, and the plan reports it.
fast_forward=true
if [ -n "$remote_sha" ] && [ "$remote_sha" != "$sha" ]; then
  "${MIRROR_GIT[@]}" merge-base --is-ancestor "$tip" "$sha"
  case $? in
    0) ;;
    1) fast_forward=false ;;
    *) die 4 "could not compare $branch with the remote $branch" ;;
  esac
fi
[ "$mode" != user ] || [ "$fast_forward" = true ] ||
  die 4 "refused: $branch at $short is not a fast-forward of the remote $branch (${remote_sha:0:12}) — devc git never force-pushes; pull or rebase first"

# ── the plan ──────────────────────────────────────────────────────────────────────────────

# json_str S — S as a JSON string. LC_ALL=C: bytes pass through, so a consumer decoding UTF-8
# sees non-UTF-8 text as U+FFFD; every control character is escaped. The replacements are quoted
# so bash 5.2's patsub_replacement never reads a `&` or `\` in them.
json_str() {
  local s=$1 i=1 c u
  s=${s//\\/"\\\\"}
  s=${s//\"/"\\\""}
  case $s in *[[:cntrl:]]*)
    while [ "$i" -lt 32 ]; do
      printf -v c "\\$(printf '%03o' "$i")"
      printf -v u '\\u%04x' "$i"
      s=${s//"$c"/"$u"}
      i=$((i + 1))
    done
    ;;
  esac
  printf '"%s"' "$s"
}

if [ "$mode" = plan ]; then
  # What the push would add to the remote: not on its default branch or the branch's own tip.
  not=(--not "refs/remotes/origin/$base")
  [ -z "$tip" ] || not+=("$tip")
  total=$("${MIRROR_GIT[@]}" rev-list --count "$sha" "${not[@]}") ||
    die 4 "could not count the commits on $branch"
  # Three NUL-terminated fields a commit, each commit then a newline (`tformat`).
  "${MIRROR_GIT[@]}" -c log.showSignature=false log --no-color --max-count=50 \
    --format='tformat:%H%x00%s%x00%an%x00' "$sha" "${not[@]}" >"$tmp/log" ||
    die 4 "could not list the commits on $branch"
  {
    printf '{"ok":true,"folder":%s,"remote":%s,"branch":%s,"sha":"%s",' \
      "$(json_str "$repo")" "$(json_str "$remote")" "$(json_str "$branch")" "$sha"
    if [ -n "$remote_sha" ]; then printf '"remoteSha":"%s",' "$remote_sha"; else
      printf '"remoteSha":null,'
    fi
    printf '"commits":['
    sep=''
    while IFS= read -r -d '' c_sha && IFS= read -r -d '' c_subject &&
      IFS= read -r -d '' c_author; do
      c_sha=${c_sha#$'\n'}
      printf '%s{"sha":"%s","subject":%s,"author":%s}' "$sep" "$c_sha" \
        "$(json_str "$c_subject")" "$(json_str "$c_author")"
      sep=,
    done <"$tmp/log"
    printf '],"totalCommits":%s,' "$total"
    if [ "$branch" = "$base" ]; then printf '"defaultBranch":true,'; else
      printf '"defaultBranch":false,'
    fi
    printf '"guarded":['
    sep=''
    for path in ${guarded[@]+"${guarded[@]}"}; do
      printf '%s%s' "$sep" "$(json_str "$path")"
      sep=,
    done
    up_to_date=false
    [ "$remote_sha" != "$sha" ] || up_to_date=true
    printf '],"lfs":%s,"fastForward":%s,"upToDate":%s}\n' "$lfs" "$fast_forward" "$up_to_date"
  } >"$tmp/plan" || die 4 "could not write the plan"
  cat -- "$tmp/plan"
  exit 0
fi

# ── publish ───────────────────────────────────────────────────────────────────────────────

if [ "$remote_sha" = "$sha" ]; then
  echo "up to date: $branch is already $short on $remote ($repo)"
  exit 0
fi

# The SHA, to a ref built from the policy: no tag, no force, no delete has a code path here.
net "pushing $branch to $remote" "${NET_GIT[@]}" push -q --no-verify --no-follow-tags -- \
  "$url" "$sha:refs/heads/$branch"
echo "pushed: $branch at $short to $remote ($repo)"
