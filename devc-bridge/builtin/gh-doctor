#!/usr/bin/env bash
# gh-doctor — explain why gh-push would or would not work, without changing anything.
#   devc-bridge gh-doctor [key]
#
# Built in, enabled by the `gh-push` capability. Run by hand on the host
# (`~/.local/state/devc-bridge/builtin/gh-doctor`) it reports every policy (or just `key`); called through the bridge it reports the caller's own and refuses any
# other, since one container has no business reading another's pin. The bridge marks a dispatched
# call by setting DEVC_BRIDGE_KEY, empty for the shared legacy token.
#
# Like gh-push, it never runs git inside a pinned repo: HEAD, refs and worktree pointers are read
# as files. Only the host-owned mirror is asked anything, plus one read-only `git ls-remote` of the
# pinned remote, over gh-push's own transport (HTTPS with gh's credential), to prove it works
# non-interactively. Like gh-push, it reports a remote that is not GitHub as unsupported.
#
# Exit codes: 0 nothing wrong found, 1 at least one finding, 2 bad usage, or (through the bridge)
# a container not granted gh-push.

set -uo pipefail
export LC_ALL=C
# The daemon's cwd is wherever `devc-bridge start` ran — possibly inside a project. Every path below
# is absolute, and no git here may discover a repo from the cwd.
cd / || exit 1

usage() {
  echo "gh-doctor: $*" >&2
  echo "usage: gh-doctor [key]" >&2
  exit 2
}
[ $# -le 1 ] || usage "takes at most one argument"
want=${1-}
if [ -n "$want" ]; then
  case $want in . | .. | *[!A-Za-z0-9._-]*) usage "invalid key ${want}" ;; esac
fi

policy_dir=${DEVC_BRIDGE_POLICY_DIR:-$HOME/.config/devc-bridge/policy}
# The knob gh-push honors, but a diagnosis should not make you wait gh-push's 300s.
timeout_s=${DEVC_BRIDGE_GIT_TIMEOUT:-30}
case $timeout_s in '' | *[!0-9]*) timeout_s=30 ;; esac
mirrors=$HOME/.local/state/devc-bridge/git
problems=0
finding() {
  problems=$((problems + 1))
  echo "  $*"
}

# ── shared with gh-push: keep the two copies identical ───────────────────────────────────

# The environment gh-push's git runs in, so the transport probe below sees what a push would.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_CONFIG GIT_CONFIG_PARAMETERS \
  GIT_CONFIG_COUNT GIT_ASKPASS SSH_ASKPASS GIT_SSH GIT_PROXY_COMMAND GIT_EXTERNAL_DIFF
export GIT_TERMINAL_PROMPT=0
export GIT_ALLOW_PROTOCOL=file:https

tmp=$(mktemp -d "${TMPDIR:-/tmp}/devc-bridge-gh-doctor.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT

# run_t CMD… — run CMD with stdin closed, killing its whole process group after $timeout_s.
# macOS ships no timeout(1). The group matters: git leaves its transport helper (git-remote-https,
# and gh under it) holding the bridge's stdout pipe, and the bridge waits for EOF on it, so killing
# git alone would still hang the client.
run_t() {
  rm -f "$tmp/timedout"
  set -m
  "$@" </dev/null &
  local pid=$!
  (
    sleep "$timeout_s"
    : >"$tmp/timedout"
    kill -s TERM -- "-$pid"
    sleep 5
    kill -s KILL -- "-$pid"
  ) </dev/null >/dev/null 2>&1 &
  local watcher=$!
  set +m
  local rc=0
  wait "$pid" 2>/dev/null || rc=$?
  kill -s TERM -- "-$watcher" 2>/dev/null
  wait "$watcher" 2>/dev/null
  return "$rc"
}

# parse_remote URL — sets head_owner/head_name. Three shapes, github.com or a `github.com-*` ssh
# host alias; anything else fails. (Verbatim from the gh-pr-* prelude.)
parse_remote() {
  local rest host path
  case $1 in
    git@*:*) rest=${1#git@} host=${rest%%:*} path=${rest#*:} ;;
    ssh://git@*/*) rest=${1#ssh://git@} host=${rest%%/*} path=${rest#*/} ;;
    https://*/*) rest=${1#https://} host=${rest%%/*} path=${rest#*/} ;;
    *) return 1 ;;
  esac
  case $host in github.com | github.com-*) ;; *) return 1 ;; esac
  case $host in *[!A-Za-z0-9.-]*) return 1 ;; esac
  path=${path%.git}
  case $path in */*) ;; *) return 1 ;; esac
  head_owner=${path%%/*}
  head_name=${path#*/}
  valid_name "$head_owner" && valid_name "$head_name"
}

valid_name() { # an owner or repo name: also keeps `..` out of an API path
  case $1 in '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;; esac
}

unset GH_REPO GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_DEBUG GH_PAGER GH_CONFIG_DIR_OVERRIDE
export GH_HOST=github.com GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 NO_COLOR=1

# transport_setup REMOTE — sets url (the HTTPS URL every network git call is given), NET_ENV
# (env assignments for them) and NET_FLAGS: no user or system git config (no `insteadOf` can turn
# it back into SSH, no other helper can answer), and gh as the only credential helper. There is no
# other transport. Fails, printing why, for a remote that is not GitHub or a gh path that cannot be
# quoted.
transport_setup() {
  NET_ENV=() NET_FLAGS=() url=''
  parse_remote "$1" || {
    echo "unsupported remote $1 — only github.com"
    return 1
  }
  url=https://github.com/$head_owner/$head_name.git
  gh_bin=$(command -v gh) || gh_bin=''
  case $gh_bin in *\'*)
    echo "unusable gh path $gh_bin"
    return 1
    ;;
  esac
  NET_ENV=(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1)
  # git runs a `!` helper through the shell, hence the quotes; the empty value resets the list.
  NET_FLAGS=(-c credential.helper= -c "credential.helper=!'$gh_bin' auth git-credential")
}

# gh_ready — 0 gh can supply the credential, 2 gh is not installed, 3 gh is
# not logged in to github.com. Needs run_t, so call it after that is defined.
GH_MISSING="gh is not installed on the host (not on the bridge's PATH)"
gh_ready() {
  [ -n "$gh_bin" ] || return 2
  run_t "$gh_bin" auth status --hostname github.com >/dev/null 2>&1 || return 3
}

phys() { (cd -P -- "$1" 2>/dev/null && pwd -P); }

# read_pointer FILE — the path after `gitdir: ` on FILE's first line, resolved against FILE's dir.
read_pointer() {
  local file=$1 first='' target
  IFS= read -r first <"$file" || [ -n "$first" ] || return 1
  target=${first#gitdir: }
  [ "$target" != "$first" ] && [ -n "$target" ] || return 1
  case $target in /*) ;; *) target=$(dirname -- "$file")/$target ;; esac
  printf '%s\n' "$target"
}

# pointer_problem WORKTREE — print why WORKTREE/.git is not an honest linked-worktree pointer and
# fail, or print its git dir and succeed. Honest means: `gitdir: <primary>/.git/worktrees/<name>`,
# whose `gitdir` points back at WORKTREE/.git and whose `commondir` is `<primary>/.git`.
pointer_problem() {
  local wt=$1 gitdir back='' common here
  gitdir=$(read_pointer "$wt/.git") || {
    echo "$wt/.git is not a gitdir: pointer"
    return 1
  }
  gitdir=$(phys "$gitdir") || {
    echo "$wt/.git points at a git dir that does not exist"
    return 1
  }
  case $gitdir in
    */.git/worktrees/*) ;;
    *)
      echo "$wt/.git points at $gitdir, not a <repo>/.git/worktrees/<name> dir"
      return 1
      ;;
  esac
  IFS= read -r back <"$gitdir/gitdir" 2>/dev/null || [ -n "$back" ] || {
    echo "$gitdir has no gitdir back-pointer"
    return 1
  }
  case $back in /*) ;; *) back=$gitdir/$back ;; esac
  here=$(phys "$wt")
  [ "$(phys "$(dirname -- "$back")")/$(basename -- "$back")" = "$here/.git" ] || {
    echo "$gitdir/gitdir does not point back at $wt/.git"
    return 1
  }
  common=$(cat -- "$gitdir/commondir" 2>/dev/null) || {
    echo "$gitdir has no commondir"
    return 1
  }
  case $common in /*) ;; *) common=$gitdir/$common ;; esac
  [ "$(phys "$common")" = "$(phys "$gitdir/../..")" ] || {
    echo "$gitdir/commondir points outside its primary git dir"
    return 1
  }
  printf '%s\n' "$gitdir"
}

# ── the report ────────────────────────────────────────────────────────────────────────────

if [ -n "${DEVC_BRIDGE_KEY+set}" ]; then
  [ -n "$DEVC_BRIDGE_KEY" ] || {
    echo "this caller uses the shared legacy token: no workspace key, so no push policy"
    exit 1
  }
  [ -z "$want" ] || [ "$want" = "$DEVC_BRIDGE_KEY" ] ||
    usage "through the bridge, only this container's own key can be inspected"
  want=$DEVC_BRIDGE_KEY
fi

keys=()
if [ -n "$want" ]; then
  keys=("$want")
else
  for f in "$policy_dir"/*.conf; do
    [ -e "$f" ] || continue
    k=${f##*/}
    keys+=("${k%.conf}")
  done
  [ ${#keys[@]} -gt 0 ] || {
    echo "no policies in $policy_dir — no container can push"
    exit 0
  }
fi

for key in "${keys[@]}"; do
  echo
  echo "key $key:"
  policy=$policy_dir/$key.conf
  if [ ! -f "$policy" ]; then
    echo "  policy    absent ($policy) — this container cannot push"
    continue
  fi
  line=$(cat -- "$policy" && printf x)
  line=${line%x}
  line=${line%$'\n'}
  tabs=${line//[!$'\t']/}
  case $line in
    *$'\n'* | *$'\r'*) tabs=bad ;;
  esac
  grants=''
  if [ ${#tabs} -eq 3 ] && [ "$tabs" != bad ]; then
    grants=${line##*$'\t'}
    [[ $grants =~ ^[a-z][a-z-]*(,[a-z][a-z-]*)*$ ]] || tabs=bad
  fi
  if [ ${#tabs} -ne 3 ] || [ "$tabs" = bad ]; then
    finding "policy    MALFORMED ($policy) — grants nothing"
    continue
  fi
  if [ -n "${DEVC_BRIDGE_KEY-}" ]; then
    case ,$grants, in
      *,gh-push,*) ;;
      *)
        echo "gh-doctor: this container was not granted gh-push" >&2
        exit 2
        ;;
    esac
  fi
  repo=${line%%$'\t'*}
  rest=${line#*$'\t'}
  remote=${rest%%$'\t'*}
  rest=${rest#*$'\t'}
  branch=${rest%%$'\t'*}
  echo "  policy    ${grants//,/, } for $branch → $remote"
  echo "  repo      $repo"

  common=''
  if [ -d "$repo/.git" ]; then
    common=$(phys "$repo/.git")
    if [ -e "$repo/.git/commondir" ]; then
      finding "repo      REDIRECTED: a primary repo with a .git/commondir — gh-push will refuse"
      common=''
    fi
  elif [ -f "$repo/.git" ]; then
    if gitdir=$(pointer_problem "$repo"); then
      echo "  repo      linked worktree ($gitdir)"
      common=$(phys "$gitdir/../..")
    else
      finding "worktree  REPOINTED: $gitdir — gh-push will refuse"
    fi
  elif [ -e "$repo" ]; then
    finding "repo      NOT A GIT REPO (no .git)"
  else
    finding "repo      MISSING"
  fi

  if [ -n "$common" ]; then
    if [ -e "$common/reftable" ]; then
      echo "  branch    unknown (reftable repo — cannot read refs as files)"
    elif [ -f "$common/refs/heads/$branch" ] ||
      grep -q " refs/heads/$branch\$" "$common/packed-refs" 2>/dev/null; then
      echo "  branch    $branch present"
    else
      finding "branch    MISSING: $branch is not in $repo"
    fi

    # Every sibling worktree of the primary: a pointer rewritten from inside a container is the one
    # thing that could make a later push read a repo it was never pinned to.
    primary=$(dirname -- "$common")
    for dotgit in "$primary.worktrees"/*/.git; do
      [ -f "$dotgit" ] || continue
      wt=${dotgit%/.git}
      if reason=$(pointer_problem "$wt"); then
        case $reason in
          "$common"/worktrees/*) ;;
          *) finding "worktree  REPOINTED: $wt/.git belongs to another repo ($reason)" ;;
        esac
      else
        finding "worktree  REPOINTED: $reason"
      fi
    done
  fi

  mirror=$mirrors/$key.git
  if [ -d "$mirror" ]; then
    origin=$(git config --file "$mirror/config" --get remote.origin.url 2>/dev/null)
    staged=$(git -c core.hooksPath=/dev/null --git-dir="$mirror" for-each-ref refs/staging 2>/dev/null |
      wc -l | tr -d ' ')
    if [ "$origin" = "$remote" ]; then
      echo "  mirror    $mirror (origin matches; $staged staging ref(s))"
    else
      finding "mirror    MISMATCH: origin ${origin:-<none>} ≠ policy $remote — gh-push will refuse"
    fi
  else
    echo "  mirror    none yet (the first gh-push creates it)"
  fi

  # Read-only and repo-less (cwd is /), over gh-push's transport: it proves the credential reaches
  # the remote, not that it may write.
  if ! transport_setup "$remote" >"$tmp/why"; then
    finding "transport FAILED: $(cat "$tmp/why")"
    continue
  fi
  gh_ready
  case $? in
    0) ;;
    2)
      finding "transport FAILED: $GH_MISSING"
      continue
      ;;
    *)
      finding "transport FAILED: gh is not authenticated for github.com — run gh auth login on the host"
      continue
      ;;
  esac
  rc=0
  run_t env ${NET_ENV[@]+"${NET_ENV[@]}"} git -c core.askPass= -c protocol.ext.allow=never \
    ${NET_FLAGS[@]+"${NET_FLAGS[@]}"} ls-remote --heads -- "$url" "refs/heads/$branch" \
    >/dev/null 2>"$tmp/ls-remote.err" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "  transport ok (git ls-remote reached $url via gh credentials)"
  elif [ -e "$tmp/timedout" ]; then
    finding "transport TIMED OUT after ${timeout_s}s reaching $url"
  else
    why=$(grep -v '^[[:space:]]*$' "$tmp/ls-remote.err" | head -n 1)
    finding "transport FAILED: git ls-remote exited $rc: ${why:-no error output}"
    echo "            GitHub remotes use gh's credentials over HTTPS: check gh auth status on the host"
  fi
done

exit $((problems > 0))
