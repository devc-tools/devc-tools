# Client build artifact (compiled at devcontainer create time)
/client/devc-bridge
# `git describe` stamps `deno task build` embeds (see ../version-info/version_info.ts)
/client/build_info.json
/host/build_info.json

# Host tool build artifacts
#   devc-bridge   — `deno task build` binary
#   host.app/     — `deno task dev` (deno desktop) bundle, for the opt-in tray
# (`start` builds nothing: it re-runs the program it was invoked as)
/host/devc-bridge
/host/host.app/
/host/DevcBridge.app/
