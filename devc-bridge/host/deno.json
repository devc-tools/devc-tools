{
  "tasks": {
    "dev": "deno desktop --hmr --allow-read --allow-write --allow-run --allow-env --allow-net main.ts run --tray",
    "build": "deno compile --include commands --include ../builtin --output devc-bridge --allow-read --allow-write --allow-run --allow-env --allow-net main.ts",
    "build:release": "deno compile --include commands --include ../builtin --target $DEVC_TARGET --output ../../dist/devc-bridge-host/devc-bridge --allow-read --allow-write --allow-run --allow-env --allow-net main.ts",
    "run": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net main.ts",
    "check": "deno check main.ts config.ts core.ts keepawake.ts token.ts tray.ts version.ts tests/relaunch_test.ts tests/start_test.ts tests/token_test.ts tests/keys_test.ts tests/capabilities_test.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    // devc-core's policy parser and capability map, from source — one definition shared with devc.
    "@devc-tools/core/": "../../devc-core/"
  }
}
