{
  "name": "Default",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers-community/features/deno:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": false
    },
    // Uncomment if your project needs Go.
    // "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      // Prefer "lts" over "latest". "latest" floats onto whatever nodejs.org currently
      // resolves as newest, which has included an unreleased alpha whose own `node --version`
      // disagreed with the directory nvm installed it under — enough to break nvm.
      "version": "lts",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    },
    // Uncomment if your project needs Python.
    // "ghcr.io/devcontainers/features/python:1": {
    //   "installTools": true,
    //   "version": "3.12"
    // }
    // Coding-agent CLIs. Set any of these to false to skip installing it.
    "ghcr.io/devc-tools/features/agents:0": {
      "installClaudeCli": true,
      "installCopilotCli": false,
      "installHerdr": true,
      "installPiCli": true,
      "piPackages": "npm:@andrewjacop/pi-herdr"
    },
    "ghcr.io/devc-tools/features/bash-config:0": {},
    "ghcr.io/devc-tools/features/git-container-config:0": {},
    "ghcr.io/devc-tools/features/node-nvmrc:0": {}
  },
  "remoteEnv": {
    "LANG": "en_US.utf8",
    "PROJECT_PATH": "${containerWorkspaceFolder}",
    "SHELL": "/bin/bash",
    // Provided by host $TZ, or defaults to America/New_York if not set.
    "TZ": "${localEnv:TZ:America/New_York}",
    // Stop the Claude CLI from overwriting the terminal title with the current task, so the
    // project-name title stays put.
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/initialize-command.sh\"",
  "mounts": [
    // Your Claude Code config, read-only and live. The agents Feature links every file here
    // into ~/.claude. Put CLAUDE.md, settings.json, statusline.sh in ~/.config/devc/.claude.
    "type=bind,source=${localEnv:HOME}/.config/devc/.claude,target=/usr/local/share/devc-features/agents/claude-seed,consistency=cached,readonly",

    // Your git name and email, extracted from the host by initialize-command.sh.
    "type=bind,source=${localEnv:HOME}/.config/devc/gitconfig-identity,target=/usr/local/share/devc-features/git-container-config/identity/gitconfig,consistency=cached,readonly",

    // Your personal shell scripts — every bashrc_*.sh in ~/.config/devc/shell.
    "type=bind,source=${localEnv:HOME}/.config/devc/shell,target=/usr/local/share/devc-features/bash-config/dirs/user,readonly",

    // Go build caches, kept out of the workspace so they survive a rebuild.
    "type=volume,source=go-cache-${localWorkspaceFolderBasename},target=/home/vscode/go/pkg",
    "type=volume,source=go-build-cache-${localWorkspaceFolderBasename},target=/root/.cache/go-build"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "denoland.vscode-deno",
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions",
        "chat.agent.maxRequests": 50,
        "chat.tools.terminal.autoApprove": { "/.*/": true },
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "statusBar.background": "#7c3aed",
          "statusBar.foreground": "#ffffff",
          "titleBar.activeBackground": "#7c3aed",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#5b21b6",
          "titleBar.inactiveForeground": "#ffffff",
          "chat.requestBorder": "#e21010",
          "statusBarItem.remoteBackground": "#e21010"
        }
      }
    }
  }
}
