{
  "name": "Default",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers-community/features/deno:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": false
    },
    // "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      // "latest" floats onto whatever nodejs.org's index currently resolves as newest —
      // including, on at least one build, an unreleased vNext alpha whose own `node --version`
      // disagreed with the directory name nvm installed it under, which broke nvm's
      // auto-use-on-source logic (node-nvmrc's postCreateCommand failing before it ever reaches
      // .nvmrc-specific logic). "lts" is what upstream's own docs recommend over "latest" for
      // exactly this reason.
      "version": "lts",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    },
    // "ghcr.io/devcontainers/features/python:1": {
    //   "installTools": true,
    //   "version": "3.12"
    // }
    // The only option this Feature still takes that devc needs. The agents Feature has no
    // path options — ~/.claude is derived from the remote user's home, and the seed
    // path is fixed. Preserves current behavior: devc's own Dockerfile used to install
    // Copilot unconditionally, and the Feature's own default is false.
    "ghcr.io/devc-tools/features/agents:0": {
      "installClaudeCli": true,
      "installCopilotCli": false,
      "installHerdr": true,
      "installPiCli": true,
      "piPackages": "npm:@andrewjacop/pi-herdr"
    },
    "ghcr.io/devc-tools/features/bash-config:0": {},
    // Bare {}, like bash-config's. There is no identityIncludePath left to pass —
    // lfsFilters, lfsSkipSmudge, worktreeRelativePaths, safeDirectory all left at their
    // defaults, which already match git-setup.sh's old behavior exactly. The identity bind
    // is retargeted in `mounts` below.
    "ghcr.io/devc-tools/features/git-container-config:0": {},
    "ghcr.io/devc-tools/features/node-nvmrc:0": {}
  },
  "remoteEnv": {
    "LANG": "en_US.utf8",
    "PROJECT_PATH": "${containerWorkspaceFolder}",
    "TZ": "America/Chicago",
    // Stop the Claude CLI from overwriting the terminal title with the current
    // task, so the project-name title set by the devc-config Feature's
    // devc:bashrc-additions fence persists.
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/initialize-command.sh\"",
  "mounts": [
    // ~/.claude folder
    "type=volume,source=claude-code-config-${localWorkspaceFolderBasename},target=/home/vscode/.claude",

    // Host ~/.claude config seed, onto the agents Feature's fixed seed path. The Feature's
    // own post-create.sh symlinks every top-level *file* from here into ~/.claude, and folds
    // ~/.claude.json into the same volume, so there is no second
    // volume to mount for it.
    "type=bind,source=${localEnv:HOME}/.config/devc/.claude,target=/usr/local/share/devc-features/agents/claude-seed,consistency=cached,readonly",

    // Git identity extracted from the host by initialize-command.sh, onto the
    // git-container-config Feature's fixed identity path. Read-only, and deliberately not the
    // host's ~/.gitconfig — see that script for why.
    "type=bind,source=${localEnv:HOME}/.config/devc/gitconfig-identity,target=/usr/local/share/devc-features/git-container-config/identity/gitconfig,consistency=cached,readonly",

    // bash-config feature user config
    "type=bind,source=${localEnv:HOME}/.config/devc/shell,target=/usr/local/share/devc-features/bash-config/dirs/user,readonly",

    "type=volume,source=go-cache-${localWorkspaceFolderBasename},target=/home/vscode/go/pkg",
    "type=volume,source=go-build-cache-${localWorkspaceFolderBasename},target=/root/.cache/go-build",
    "type=volume,source=node-modules-${localWorkspaceFolderBasename},target=${containerWorkspaceFolder}/node_modules"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "denoland.vscode-deno",
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions",
        "chat.agent.maxRequests": 50,
        "chat.tools.terminal.autoApprove": { "/.*/": true },
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "statusBar.background": "#7c3aed",
          "statusBar.foreground": "#ffffff",
          "titleBar.activeBackground": "#7c3aed",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#5b21b6",
          "titleBar.inactiveForeground": "#ffffff",
          "chat.requestBorder": "#e21010",
          "statusBarItem.remoteBackground": "#e21010"
        }
      }
    }
  }
}
