{
  "name": "devc-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "devc web in its own window, with a host terminal devc web cannot reach",
  "license": "MIT",
  "main": "build/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "node build.mjs",
    "check": "tsc --noEmit -p .",
    "test": "node --import ./tests/devc_web_alias.mjs --test \"tests/*.test.ts\"",
    "start": "node build.mjs && electron .",
    "build": "node build.mjs && electron-builder --publish never",
    "build:mac": "node build.mjs && electron-builder --mac dir --x64 --arm64 --publish never -c.npmRebuild=false"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "44.5.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.devc-tools.devc-desktop",
    "productName": "devcd",
    "files": [
      "build/**",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": "dir",
      "icon": "icon.png",
      "executableName": "devc-desktop"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
