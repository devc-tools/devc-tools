{
  // devc-desktop is an npm project (Electron); this file only keeps `deno fmt`, which formats
  // the whole repo, on the repo's style here too. With a package.json and no deno.json in this
  // folder, Deno would fall back to its own defaults.
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": ["build/", "dist/", "node_modules/"]
  }
}
