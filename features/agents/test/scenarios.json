{
  "with_seed": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "onCreateCommand": "sudo mkdir -p /usr/local/share/devc-features/agents/claude-seed/skills && sudo chmod -R 777 /usr/local/share/devc-features/agents/claude-seed && printf '# md\\n' > /usr/local/share/devc-features/agents/claude-seed/CLAUDE.md && printf '{}\\n' > /usr/local/share/devc-features/agents/claude-seed/settings.json && echo 'a skill' > /usr/local/share/devc-features/agents/claude-seed/skills/inner.md",
    "features": {
      "agents": {}
    }
  },
  "with_declared_volume": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "agents": {}
    }
  },
  "with_copilot": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "agents": {
        "installCopilotCli": true
      }
    }
  },
  "with_pi": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "ghcr.io/devcontainers/features/node:1": {
        "version": "lts"
      },
      "agents": {
        "installPiCli": true
      }
    }
  },
  "with_herdr": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "agents": {
        "installHerdr": true
      }
    }
  },
  "with_pi_packages": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "ghcr.io/devcontainers/features/node:1": {
        "version": "lts"
      },
      "agents": {
        "installPiCli": true,
        "piPackages": "npm:@andrewjacop/pi-herdr"
      }
    }
  },
  "with_herdr_plugins": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "agents": {
        "installHerdr": true,
        "herdrPlugins": "bmingles/herdr-plugins/agent-caffeinate"
      }
    }
  },
  "with_mismatched_home": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "root",
    "features": {
      "agents": {}
    }
  }
}
